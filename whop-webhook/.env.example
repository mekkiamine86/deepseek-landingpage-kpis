# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Whop webhook secret, copied from the webhook you create in the Whop dashboard
# (Developer tab -> Create Webhook). Starts with "whsec_".
WHOP_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Sender address. Must come from a domain you verified in Resend.
EMAIL_FROM=Restaurant Survival Toolkit <deliveries@yourdomain.com>

# Address customers can reply to.
SUPPORT_EMAIL=support@yourdomain.com

# Public download links. Use Supabase Storage public URLs.
BOOK_DOWNLOAD_URL=https://<project-ref>.supabase.co/storage/v1/object/public/freebies/restaurant-survival-toolkit-2026.pdf
EXCEL_BUNDLE_DOWNLOAD_URL=https://<project-ref>.supabase.co/storage/v1/object/public/freebies/restaurant-survival-toolkit-2026.xlsx
